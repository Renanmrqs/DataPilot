# Copy to .env and enter credentials locally. Never commit .env.
# Model IDs are configured explicitly; use IDs available in each provider account.
# Comma-separated lists let you compare multiple models from the same provider.
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=
GEMINI_API_KEY=
GEMINI_MODELS=
OPENAI_API_KEY=
OPENAI_MODELS=

# Optional other provider implementing POST /chat/completions.
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODELS=

# Public demo authentication and persistent quotas (integration in progress).
NEON_AUTH_BASE_URL=
# PostgreSQL pooled connection string; server-side secret.
NEON_DATABASE_URL=

# Public demo: enabled automatically on Vercel; true also enables it locally.
DEMO_MODE=false
# Keep false until email login, database quotas and deployment are verified.
DEMO_AI_ENABLED=false
DEMO_QUESTIONS_PER_USER=4
# Global questions per UTC day, shared by all users; not provider API calls.
DEMO_DAILY_QUESTIONS=20
DEMO_COOLDOWN_SECONDS=15
# Select one of the configured providers/models above for public use.
DEMO_PROVIDER=
DEMO_MODEL=

# Optional second public choice. Both pairs share the same account quota.
DEMO_ALTERNATE_PROVIDER=
DEMO_ALTERNATE_MODEL=
